{
  "manifest_version": 3,
  "name": "Website Change Detector",
  "version": "1.0.0",
  "description": "Track the current page with one click.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Track this page" }
}
