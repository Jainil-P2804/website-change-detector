# Copy to .env and edit.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://wcd:wcd@postgres:5432/wcd
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-to-a-long-random-string

# Where screenshots and diff images are stored (mount a volume or swap in S3).
ARTIFACT_DIR=/data/artifacts

# Worker tuning
WORKER_CONCURRENCY=4
SCRAPE_TIMEOUT_MS=45000
SCRAPE_ATTEMPTS=3
# Max simultaneous fetches / minimum gap between fetches per target domain
DOMAIN_MAX_CONCURRENT=2
DOMAIN_MIN_GAP_MS=3000

# Alert fatigue guard: if more than N snapshots appear in WINDOW minutes, mark page "volatile"
VOLATILE_MAX_CHANGES=6
VOLATILE_WINDOW_MIN=60

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Website Change Detector <alerts@example.com>"

# Optional LLM summary (Anthropic Messages API)
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
